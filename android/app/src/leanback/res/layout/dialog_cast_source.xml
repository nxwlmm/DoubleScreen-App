<?xml version="1.0" encoding="utf-8"?>
<!--
  局域网极速投源面板。
  电视端严禁出现任何文本输入 —— 这个面板的存在意义就是让用户"用手机打字，电视只负责显示"。
  布局为左（二维码）右（服务信息）双栏。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="@dimen/tv_cast_panel_width"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:orientation="vertical">

    <!-- ============ 标题栏 ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_xl"
        android:paddingTop="20dp"
        android:paddingEnd="@dimen/space_xl"
        android:paddingBottom="20dp">

        <FrameLayout
            android:id="@+id/header_icon"
            android:layout_width="30dp"
            android:layout_height="30dp">

            <ImageView
                android:id="@+id/header_icon_image"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_cast" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="@string/cast_title"
            android:textColor="@color/text_main"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/cast_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:paddingStart="11dp"
            android:paddingTop="4dp"
            android:paddingEnd="11dp"
            android:paddingBottom="4dp"
            android:text="@string/cast_badge"
            android:textColor="@color/text_dim"
            android:textSize="@dimen/text_mono" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#14FFFFFF" />

    <!-- ============ 主体 ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/space_xl">

        <!-- 左栏：二维码 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/qr_frame"
                android:layout_width="@dimen/tv_qr_size"
                android:layout_height="@dimen/tv_qr_size"
                android:background="@drawable/bg_qr_frame">

                <ImageView
                    android:id="@+id/qr_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="10dp"
                    android:contentDescription="@string/a11y_qr_code"
                    android:scaleType="fitCenter"
                    android:visibility="invisible"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/qr_placeholder"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="monospace"
                    android:text="@string/cast_url_pending"
                    android:textColor="@color/text_dim"
                    android:textSize="@dimen/text_mono" />
            </FrameLayout>

            <TextView
                android:id="@+id/qr_caption"
                android:layout_width="@dimen/tv_qr_size"
                android:layout_height="wrap_content"
                android:layout_marginTop="11dp"
                android:gravity="center"
                android:text="@string/cast_qr_caption"
                android:textColor="@color/text_dim"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 右栏：服务信息与引导 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="28dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/service_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:paddingStart="12dp"
                android:paddingTop="5dp"
                android:paddingEnd="12dp"
                android:paddingBottom="5dp"
                android:textSize="11sp"
                tools:text="推送服务运行中 · 端口 9978" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/cast_started"
                android:textColor="@color/text_main"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/cast_hint"
                android:textColor="@color/text_sub"
                android:textSize="12.5sp" />

            <!-- 服务地址：可点击复制 -->
            <TextView
                android:id="@+id/service_url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="11dp"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="monospace"
                android:paddingStart="16dp"
                android:paddingTop="13dp"
                android:paddingEnd="16dp"
                android:paddingBottom="13dp"
                android:textSize="17sp"
                tools:text="http://192.168.1.108:9978/?token=8a3f9e" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="4dp"
                    android:text="@string/cast_step_1"
                    android:textColor="@color/text_sub"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="4dp"
                    android:text="@string/cast_step_2"
                    android:textColor="@color/text_sub"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="4dp"
                    android:text="@string/cast_step_3"
                    android:textColor="@color/text_sub"
                    android:textSize="12sp" />
            </LinearLayout>

            <Space
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_refresh_url"
                    style="@style/Tv.DialogButton"
                    android:text="@string/cast_refresh_url" />

                <TextView
                    android:id="@+id/btn_panel_close"
                    style="@style/Tv.DialogButton"
                    android:layout_marginStart="10dp"
                    android:text="@string/action_close" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/cast_no_input_note"
                android:textColor="@color/text_dim"
                android:textSize="@dimen/text_mono" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
