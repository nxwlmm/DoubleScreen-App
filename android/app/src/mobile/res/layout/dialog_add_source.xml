<?xml version="1.0" encoding="utf-8"?>
<!-- 新增配置弹窗（手机端保留文本输入；电视端的等价入口是局域网投源面板） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="20dp"
    android:paddingEnd="22dp"
    android:paddingBottom="8dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/add_dialog_label_url"
        android:textColor="@color/text_sub"
        android:textSize="12sp" />

    <!--
      支持一次粘贴多条：每行一个链接，行内可用「# 备注」补充名称。
      imeOptions=flagNoEnterAction 让回车是换行而不是"完成"，否则多行粘贴会被截断。
    -->
    <EditText
        android:id="@+id/input_url"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:autofillHints=""
        android:background="@drawable/bg_input"
        android:fontFamily="monospace"
        android:gravity="top|start"
        android:hint="@string/add_dialog_url_hint"
        android:importantForAutofill="no"
        android:imeOptions="flagNoEnterAction"
        android:inputType="textMultiLine"
        android:minLines="5"
        android:minHeight="136dp"
        android:padding="13dp"
        android:scrollbars="vertical"
        android:textColor="@color/text_main"
        android:textColorHint="@color/text_dim"
        android:textSize="12.5sp" />

    <TextView
        android:id="@+id/btn_paste"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:background="@drawable/bg_mini_dashed"
        android:paddingStart="12dp"
        android:paddingTop="7dp"
        android:paddingEnd="12dp"
        android:paddingBottom="7dp"
        android:text="@string/add_dialog_paste"
        android:textColor="@color/accent_standard"
        android:textSize="11.5sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/add_dialog_kind"
        android:textColor="@color/text_sub"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/kind_single"
            style="@style/Mobile.KindOption"
            android:text="@string/kind_single" />

        <TextView
            android:id="@+id/kind_multi"
            style="@style/Mobile.KindOption"
            android:layout_marginStart="8dp"
            android:text="@string/kind_multi" />

        <TextView
            android:id="@+id/kind_live"
            style="@style/Mobile.KindOption"
            android:layout_marginStart="8dp"
            android:text="@string/kind_live" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/add_dialog_label_name"
        android:textColor="@color/text_sub"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/input_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:autofillHints=""
        android:background="@drawable/bg_input"
        android:hint="@string/add_dialog_name_hint"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLines="1"
        android:padding="13dp"
        android:textColor="@color/text_main"
        android:textColorHint="@color/text_dim"
        android:textSize="13.5sp" />

</LinearLayout>
