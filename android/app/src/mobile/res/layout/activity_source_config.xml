<?xml version="1.0" encoding="utf-8"?>
<!--
  手机端主界面 · 源配置管理。
  与 TV 端的关键差异：没有全局 Tabbar（改成纯列表 + 顶栏开关），
  卡片操作靠左滑而不是焦点操作条。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_deep"
    android:orientation="vertical">

    <!-- ================= 顶栏 ================= -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/mobile_top_bar_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/mobile_screen_padding_h"
        android:paddingEnd="@dimen/mobile_screen_padding_h">

        <TextView
            android:id="@+id/nav_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:fontFamily="monospace"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="@string/nav_back"
            android:textColor="@color/text_dim"
            android:textSize="12sp" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- 直播入口：进入直播频道列表（列表内容来自配置库里 LIVE 类型的源） -->
        <TextView
            android:id="@+id/btn_live"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:fontFamily="monospace"
            android:padding="10dp"
            android:text="@string/live_entry"
            android:textColor="@color/accent_mint"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- 无痕开关胶囊（位于加号左侧） -->
        <LinearLayout
            android:id="@+id/incognito_pill"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="13dp"
            android:paddingEnd="13dp">

            <ImageView
                android:id="@+id/incognito_icon"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:contentDescription="@string/a11y_incognito_toggle"
                android:src="@drawable/ic_goggles" />

            <TextView
                android:id="@+id/incognito_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/incognito_short"
                android:textColor="@color/text_sub"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/btn_add_top"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/btn_add_top_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:contentDescription="@string/action_add"
                android:src="@drawable/ic_plus" />
        </FrameLayout>
    </LinearLayout>

    <!-- ================= 标题区 ================= -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="2dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/source_config_title"
            android:textColor="@color/text_main"
            android:textSize="@dimen/text_page_title"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/count_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:fontFamily="monospace"
            android:textColor="@color/text_dim"
            android:textSize="11sp"
            tools:text="3 个配置 · 左滑卡片可快捷操作" />
    </LinearLayout>

    <!-- 合规提示条 -->
    <TextView
        android:id="@+id/tip_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/mobile_screen_padding_h"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="@dimen/mobile_screen_padding_h"
        android:layout_marginBottom="14dp"
        android:lineSpacingExtra="3dp"
        android:paddingStart="13dp"
        android:paddingTop="11dp"
        android:paddingEnd="13dp"
        android:paddingBottom="11dp"
        android:text="@string/mobile_tip"
        android:textColor="@color/text_sub"
        android:textSize="11.5sp" />

    <!-- ================= 列表 ================= -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/source_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingStart="@dimen/mobile_screen_padding_h"
            android:paddingEnd="@dimen/mobile_screen_padding_h"
            android:paddingBottom="16dp"
            android:scrollbars="none"
            tools:itemCount="3"
            tools:listitem="@layout/item_source_config" />

        <LinearLayout
            android:id="@+id/empty_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:visibility="gone"
            tools:visibility="visible">

            <FrameLayout
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:background="@drawable/bg_empty_art_mobile">

                <ImageView
                    android:id="@+id/empty_icon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_source_single" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/empty_add_first"
                android:textColor="@color/text_main"
                android:textSize="14.5sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:text="@string/empty_hint_mobile"
                android:textColor="@color/text_dim"
                android:textSize="11.5sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- ================= 底部 ================= -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="@dimen/mobile_screen_padding_h"
        android:paddingEnd="@dimen/mobile_screen_padding_h">

        <TextView
            android:id="@+id/btn_copy_all"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center"
            android:fontFamily="monospace"
            android:text="@string/action_copy_all"
            android:textColor="@color/text_dim"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btn_add_bottom"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1.4"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/action_add"
            android:textSize="13.5sp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="14dp"
        android:text="@string/mobile_footer_hint"
        android:textColor="@color/text_dim"
        android:textSize="10.5sp" />

</LinearLayout>
